---
import type { BlogPost } from '../lib/content/blog';

interface Props {
	series: string;
	posts: BlogPost[];
	currentPostId: string;
}

const { series, posts, currentPostId } = Astro.props;
---

<details class="series-navigation">
	<summary aria-label={`${series}系列目录`}>
		<span class="series-copy">
			<span class="series-label">文章系列</span>
			<strong>此篇文章属于「{series}」</strong>
		</span>
		<span class="series-count">{posts.length} 篇</span>
		<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5" /></svg>
	</summary>
	<nav aria-label={`${series}系列文章`}>
		<ol>
			{posts.map((post, index) => (
				<li class={post.id === currentPostId ? 'current' : undefined}>
					<span class="series-number">{index + 1}</span>
					<a href={`/blog/${post.id}/`} aria-current={post.id === currentPostId ? 'page' : undefined}>
						{post.data.title}
					</a>
				</li>
			))}
		</ol>
	</nav>
</details>

<style>
	.series-navigation {
		position: sticky;
		top: calc(var(--header-height) + 1rem);
		z-index: 30;
		margin: -1rem 0 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.series-navigation summary {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 3.5rem;
		padding: 0.45rem 1.25rem;
		cursor: pointer;
		list-style: none;
	}

	.series-navigation summary::-webkit-details-marker {
		display: none;
	}

	.series-copy {
		display: grid;
		flex: 1;
		gap: 0.2rem;
		min-width: 0;
	}

	.series-navigation summary strong {
		flex: 1;
		min-width: 0;
		color: var(--color-text-strong);
		font-size: 0.96rem;
		overflow-wrap: anywhere;
	}

	.series-label,
	.series-count {
		color: var(--color-text-muted);
		font-size: 0.82rem;
	}

	.series-count {
		flex: 0 0 auto;
		color: var(--accent);
	}

	.series-navigation summary svg {
		flex: 0 0 1rem;
		width: 1rem;
		height: 1rem;
		color: var(--accent);
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		transition: transform 0.2s ease;
	}

	.series-navigation[open] summary svg {
		transform: rotate(180deg);
	}

	.series-navigation nav {
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		width: 100%;
		max-height: min(60vh, 24rem);
		overflow-y: auto;
		padding: 0.5rem 0;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.series-navigation ol {
		margin: 0;
		padding: 0 0.5rem;
		list-style: none;
	}

	.series-navigation li {
		display: flex;
		align-items: baseline;
		gap: 0.65rem;
		margin: 0;
		padding: 0.3rem 0.45rem;
		border-radius: 4px;
	}

	.series-number {
		flex: 0 0 1.5rem;
		color: var(--color-text-muted);
		font-size: 0.84rem;
		text-align: right;
	}

	.series-navigation a {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.series-navigation a:hover {
		color: var(--accent);
	}

	.series-navigation li.current {
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}

	.series-navigation li.current a {
		color: var(--accent);
		font-weight: 600;
	}

	.series-navigation summary:focus-visible,
	.series-navigation a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	@media (max-width: 768px) {
		.series-navigation summary {
			min-height: 3.35rem;
			gap: 0.75rem;
			padding: 0.45rem 1rem;
		}

		.series-navigation summary strong {
			font-size: 0.95rem;
		}
	}
</style>
